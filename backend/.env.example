# Copy to .env and fill in. Only the /extract (question answering) step uses Claude; extraction itself uses no AI.
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-5-5
# MAX_CONTEXT_CHARS=1200000
# CLAUDE_MAX_TOKENS=64000
# CORS_ORIGINS=http://localhost:5173
# SEC requires a real contact for questions answered from filings, e.g. Company Name your.name@company.com
SEC_USER_AGENT=
