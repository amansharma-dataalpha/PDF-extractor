  "step_4_validation_checks": [
    {
      "id": "chk.balance_sheet_balances",
      "name": "Balance sheet balances",
      "rule": "bs.total_assets == bs.total_liabilities + bs.total_equity",
      "tolerance": "1",
      "severity": "CRITICAL",
      "alert_message": "Total assets do not equal total liabilities plus equity.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.bs_total_matches",
      "name": "Assets equal liabilities & equity total",
      "rule": "bs.total_assets == bs.total_liabilities_equity",
      "tolerance": "0",
      "severity": "CRITICAL",
      "alert_message": "Total assets and 'Total liabilities and equity' differ.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.gross_margin",
      "name": "Gross margin arithmetic",
      "rule": "is.gross_margin == is.total_revenue - is.cost_of_revenue",
      "tolerance": "1",
      "severity": "HIGH",
      "alert_message": "Gross margin does not equal revenue minus cost of revenue.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.operating_income",
      "name": "Operating income arithmetic",
      "rule": "is.operating_income == is.gross_margin - is.rnd - is.sales_marketing - is.gna",
      "tolerance": "1",
      "severity": "MEDIUM",
      "alert_message": "Operating income does not equal gross margin minus operating expenses.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.pretax_income",
      "name": "Pre-tax income arithmetic",
      "rule": "is.pretax_income == is.operating_income + is.other_income",
      "tolerance": "1",
      "severity": "HIGH",
      "alert_message": "Income before taxes does not equal operating income plus other income.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.net_income",
      "name": "Net income arithmetic",
      "rule": "is.net_income == is.pretax_income - is.income_tax",
      "tolerance": "1",
      "severity": "CRITICAL",
      "alert_message": "Net income does not equal pre-tax income minus tax.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.net_income_tie_cf",
      "name": "Net income ties to cash flow",
      "rule": "is.net_income == first line of cash flow statement",
      "tolerance": "0",
      "severity": "HIGH",
      "alert_message": "Net income on the income statement differs from the cash flow statement.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.cash_tie",
      "name": "Cash ties between statements",
      "rule": "bs.cash == cf.cash_end",
      "tolerance": "0",
      "severity": "CRITICAL",
      "alert_message": "Cash on the balance sheet differs from ending cash on the cash flow statement.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.cash_rollforward",
      "name": "Cash roll-forward",
      "rule": "cf.net_change == cf.operating + cf.investing + cf.financing + cf.fx_effect",
      "tolerance": "1",
      "severity": "HIGH",
      "alert_message": "Operating + investing + financing + FX does not equal the net change in cash.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.cash_begin_end",
      "name": "Beginning + change = ending cash",
      "rule": "cf.cash_end == cf.cash_beginning + cf.net_change",
      "tolerance": "1",
      "severity": "HIGH",
      "alert_message": "Beginning cash plus net change does not equal ending cash.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.prior_cash",
      "name": "Prior-year ending cash = current beginning cash",
      "rule": "cf.cash_beginning(FY) == bs.cash(FY-1)",
      "tolerance": "0",
      "severity": "MEDIUM",
      "alert_message": "Beginning cash does not match prior year-end balance sheet cash.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.eps_basic",
      "name": "Basic EPS recomputes",
      "rule": "is.eps_basic == is.net_income / is.shares_basic",
      "tolerance": "0.02",
      "severity": "MEDIUM",
      "alert_message": "Basic EPS does not match net income / weighted basic shares.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.eps_order",
      "name": "Diluted EPS <= basic EPS",
      "rule": "is.eps_diluted <= is.eps_basic (when net income > 0)",
      "tolerance": "0",
      "severity": "MEDIUM",
      "alert_message": "Diluted EPS is higher than basic EPS.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.current_subtotal",
      "name": "Current assets within total",
      "rule": "bs.total_current_assets <= bs.total_assets",
      "tolerance": "0",
      "severity": "HIGH",
      "alert_message": "Current assets exceed total assets.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.comparatives",
      "name": "Comparative periods present",
      "rule": "Income/cash flow statements show 3 years; balance sheet 2 (SRC: 2 and 2)",
      "tolerance": "-",
      "severity": "HIGH",
      "alert_message": "Required comparative fiscal periods are missing.",
      "sample_result": "PASS"
    },
    {
      "id": "chk.period_consistency",
      "name": "Fiscal year matches cover",
      "rule": "Statement column headers match cover 'Fiscal Year Ended'",
      "tolerance": "-",
      "severity": "HIGH",
      "alert_message": "Financial statement periods do not match the fiscal year on the cover page.",
      "sample_result": "PASS"
    }
  ],
  "step_5_health_signals": [
    {
      "id": "health.net_loss",
      "name": "Net loss",
      "rule": "is.net_income < 0",
      "severity": "MEDIUM",
      "alert_message": "Company reported a net loss.",
      "sample_result": "OK"
    },
    {
      "id": "health.negative_ocf",
      "name": "Negative operating cash flow",
      "rule": "cf.operating < 0",
      "severity": "HIGH",
      "alert_message": "Operations consumed cash this year.",
      "sample_result": "OK"
    },
    {
      "id": "health.negative_equity",
      "name": "Negative equity",
      "rule": "bs.total_equity < 0",
      "severity": "HIGH",
      "alert_message": "Stockholders' equity is negative.",
      "sample_result": "OK"
    },
    {
      "id": "health.current_ratio",
      "name": "Low liquidity",
      "rule": "bs.total_current_assets / bs.total_current_liabilities < 1.0",
      "severity": "MEDIUM",
      "alert_message": "Current ratio below 1.0.",
      "sample_result": "OK"
    },
    {
      "id": "health.leverage",
      "name": "High leverage",
      "rule": "(bs.current_debt + bs.long_term_debt) / bs.total_equity > 2.0",
      "severity": "MEDIUM",
      "alert_message": "Debt-to-equity above 2.0.",
      "sample_result": "OK"
    },
    {
      "id": "health.revenue_decline",
      "name": "Revenue decline",
      "rule": "is.total_revenue(FY) < is.total_revenue(FY-1) * 0.9",
      "severity": "MEDIUM",
      "alert_message": "Revenue fell more than 10% year over year.",
      "sample_result": "OK"
    },
    {
      "id": "health.cash_drop",
      "name": "Large cash drop",
      "rule": "bs.cash(FY) < bs.cash(FY-1) * 0.5",
      "severity": "LOW",
      "alert_message": "Cash fell by more than half year over year.",
      "sample_result": "OK"
    }
  ],
  "step_6_red_flag_phrases": [
    {
      "id": "flag.going_concern",
      "pattern": "substantial doubt|going concern",
      "severity": "CRITICAL",
      "alert_message": "Auditor or management raised going-concern doubt."
    },
    {
      "id": "flag.material_weakness",
      "pattern": "material weakness",
      "severity": "CRITICAL",
      "alert_message": "A material weakness in internal control is disclosed."
    },
    {
      "id": "flag.controls_not_effective",
      "pattern": "(controls and procedures|internal control over financial reporting) (were|was|are|is) not effective",
      "severity": "CRITICAL",
      "alert_message": "Controls concluded NOT effective."
    },
    {
      "id": "flag.adverse_opinion",
      "pattern": "adverse opinion|do not present fairly",
      "severity": "CRITICAL",
      "alert_message": "Auditor issued an adverse opinion."
    },
    {
      "id": "flag.qualified_opinion",
      "pattern": "except for the effects|qualified opinion",
      "severity": "CRITICAL",
      "alert_message": "Auditor issued a qualified opinion."
    },
    {
      "id": "flag.disclaimer",
      "pattern": "do not express an opinion|disclaimer of opinion",
      "severity": "CRITICAL",
      "alert_message": "Auditor disclaimed an opinion."
    },
    {
      "id": "flag.restatement",
      "pattern": "restate(d|ment) (of )?(our |the )?(previously issued )?financial statements|non-reliance",
      "severity": "HIGH",
      "alert_message": "Prior financial statements were restated."
    },
    {
      "id": "flag.auditor_change",
