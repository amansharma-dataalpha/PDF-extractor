{
  "template_name": "SEC Form 10-K - Required Fields & Validation Template",
  "version": "1.0",
  "reference_document": {
    "company": "Microsoft Corporation",
    "form": "10-K",
    "fiscal_year_end": "2026-06-30",
    "filed": "2026-07-29",
    "pages": 124,
    "units": "USD millions, except per-share amounts"
  },
  "severity_levels": {
    "CRITICAL": "Filing is incomplete or unreliable - block / escalate",
    "HIGH": "Required disclosure missing - must be reviewed",
    "MEDIUM": "Expected content missing or inconsistent - review",
    "LOW": "Informational / optional item absent"
  },
  "status_rule": "INCOMPLETE if any CRITICAL alert; NEEDS_REVIEW if any HIGH alert; otherwise COMPLETE (MEDIUM/LOW are listed but do not block).",
  "step_1_classification": {
    "rule": "Classify as 10-K when the MUST signal is found AND at least 4 of the 6 SUPPORTING signals are found, AND no EXCLUDE signal is found on the cover page.",
    "must": [
      {
        "id": "form_10k",
        "pattern": "FORM\\s+10-K\\b",
        "where": "first 2 pages",
        "msft_page": 1
      }
    ],
    "supporting": [
      {
        "id": "sec_header",
        "pattern": "SECURITIES AND EXCHANGE COMMISSION",
        "msft_page": 1
      },
      {
        "id": "annual_report",
        "pattern": "ANNUAL REPORT PURSUANT TO SECTION 13 OR 15\\(d\\)",
        "msft_page": 1
      },
      {
        "id": "fiscal_year_ended",
        "pattern": "For the Fiscal Year Ended",
        "msft_page": 1
      },
      {
        "id": "commission_file_no",
        "pattern": "Commission File Number\\s*[0-9-]+",
        "msft_page": 1
      },
      {
        "id": "item_1a",
        "pattern": "Item\\s+1A\\.?\\s+Risk Factors",
        "msft_page": 2
      },
      {
        "id": "item_8",
        "pattern": "Item\\s+8\\.?\\s+Financial Statements and Supplementary Data",
        "msft_page": 2
      }
    ],
    "exclude": [
      {
        "id": "form_10q",
        "pattern": "FORM\\s+10-Q|QUARTERLY REPORT PURSUANT",
        "means": "Quarterly report, not a 10-K"
      },
      {
        "id": "form_8k",
        "pattern": "FORM\\s+8-K|CURRENT REPORT PURSUANT",
        "means": "Current report, not a 10-K"
      },
      {
        "id": "form_20f",
        "pattern": "FORM\\s+20-F",
        "means": "Foreign private issuer annual report"
      }
    ],
    "variants": [
      {
        "id": "10-K/A",
        "pattern": "FORM\\s+10-K/A",
        "note": "Amendment - may legitimately contain only some Items; relax completeness checks and flag as LOW."
      },
      {
        "id": "10-KT",
        "pattern": "TRANSITION REPORT PURSUANT.*\\u2612|\\u2612\\s*TRANSITION REPORT",
        "note": "Transition report - fiscal period is not 12 months."
      }
    ]
  },
