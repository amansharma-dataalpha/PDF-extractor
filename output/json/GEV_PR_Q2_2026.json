  "Guidance date and period": {
   "row": 14,
   "group": "Guidance",
   "content": {
    "heading": "2026 Guidance",
    "text": "2026 Guidance\nGE Vernova is raising its 2026 financial guidance and now expects revenue of $45.5-$46.5 billion, up from $44.5-$45.5 billion,\nand free cash flow* of $11.5-$12.5 billion, up from $6.5-$7.5 billion; adjusted EBITDA margin* guidance remains 12%-14%.\nSegment guidance is:\n• Power: 18%-20% organic revenue* growth, up from 16%-18%, and 17%-19% segment EBITDA margin.\n• Electrification: Revenue of $14.5-$15.0 billion, inclusive of approximately $3.1 billion from Prolec GE, up from\n$14.0-$14.5 billion, inclusive of approximately $3.0 billion from Prolec GE, and 18%-20% segment EBITDA margin.\n• Wind: Organic revenue* down low-double digits and approximately $400 million of segment EBITDA losses.",
    "pages": [
     2,
     2
    ]
   }
  },
  "Revenue guidance": {
   "row": 15,
   "group": "Guidance",
   "content": [
    {
     "text": "2026 Guidance GE Vernova is raising its 2026 financial guidance and now expects revenue of $45.5-$46.5 billion, up from $44.5-$45.5 billion, and free cash flow* of $11.5-$12.5 billion, up from $6.5-$7.5 billion; adjusted EBITDA margin* guidance remains 12%-14%.",
     "page": 2
    },
    {
     "text": "Segment guidance is: • Power: 18%-20% organic revenue* growth, up from 16%-18%, and 17%-19% segment EBITDA margin. • Electrification: Revenue of $14.5-$15.0 billion, inclusive of approximately $3.1 billion from Prolec GE, up from $14.0-$14.5 billion, inclusive of approximately $3.0 billion from Prolec GE, and 18%-20% segment EBITDA margin. • Wind: Organic revenue* down low-double digits and approximately $400 million of segment EBITDA losses.",
     "page": 2
    }
   ]
  },
